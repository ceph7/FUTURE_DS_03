      <aliases enabled='yes' />
      <column caption='Contact Threshold Status' datatype='string' name='[Calculation_3800291396112385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [campaign] &lt;= 3 THEN &quot;Optimal (&lt;= 3 Calls)&quot;&#10;ELSE &quot;Over-contacted (&gt; 3 Calls)&quot;&#10;END' />
      </column>
      <column caption='Conversion Rate' datatype='real' name='[Calculation_3800291396452354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [y] = &quot;yes&quot; THEN 1 ELSE 0 END) / COUNT([y])' />
      </column>
      <column caption='Preferred Channel Flag' datatype='string' name='[Calculation_3800291396882435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([contact]) = &quot;cellular&quot; OR LOWER([contact]) = &quot;mobile&quot; THEN &quot;High Priority (Mobile)&quot;&#10;ELSE &quot;Standard Priority (Landline)&quot;&#10;END' />
      </column>
      <column caption='Customer Segment Priority' datatype='string' name='[Calculation_3800291396952068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([job]) = &quot;student&quot; OR LOWER([job]) = &quot;retired&quot; THEN &quot;Tier 1: High Value (&gt;25% CR)&quot;&#10;ELSE &quot;Tier 2: Standard Profile&quot;&#10;END' />
      </column>
      <column caption='Lead Temperature' datatype='string' name='[Calculation_3800291397017605]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [poutcome] = &quot;success&quot; THEN &quot;Hot Lead (Past Success &gt;65% CR)&quot;&#10;ELSEIF [pdays] &lt; 999 AND [pdays] &gt;= 0 THEN &quot;Warm Lead (Recent Contact &gt;60% CR)&quot;&#10;ELSE &quot;Cold Lead (New Prospect)&quot;&#10;END' />
      </column>
      <column caption='Seasonal Efficiency Tier' datatype='real' name='[Calculation_3800291397083142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IN(LOWER([month]), &quot;mar&quot;, &quot;sep&quot;, &quot;oct&quot;, &quot;dec&quot;) THEN &quot;High Conversion Month (&gt;40%)&quot;&#10;ELSEIF IN(LOWER([month]), &quot;may&quot;, &quot;jul&quot;, &quot;aug&quot;) THEN &quot;Low Conversion / High Volume&quot;&#10;ELSE &quot;Moderate Conversion Month&quot;&#10;END' />
      </column>
      <column caption='Sheet1' datatype='table' name='[__tableau_internal_object_id__].[Sheet1_5D6CEB26196A4CF2AD883B901B510EB8]' role='measure' type='quantitative' />
