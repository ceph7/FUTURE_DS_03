    <worksheet name='Température des Leads'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Times New Roman'>LEADS TEMPERATURE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (bank-additional-full)' name='federated.0vpww2514ccrli123ritp0u29oua' />
          </datasources>
          <datasource-dependencies datasource='federated.0vpww2514ccrli123ritp0u29oua'>
            <column caption='Contact Threshold Status' datatype='string' name='[Calculation_3800291396112385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [campaign] &lt;= 3 THEN &quot;Optimal (&lt;= 3 Calls)&quot;&#10;ELSE &quot;Over-contacted (&gt; 3 Calls)&quot;&#10;END' />
            </column>
            <column caption='Conversion Rate' datatype='real' name='[Calculation_3800291396452354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [y] = &quot;yes&quot; THEN 1 ELSE 0 END) / COUNT([y])' />
            </column>
            <column caption='Lead Temperature' datatype='string' name='[Calculation_3800291397017605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [poutcome] = &quot;success&quot; THEN &quot;Hot Lead (Past Success &gt;65% CR)&quot;&#10;ELSEIF [pdays] &lt; 999 AND [pdays] &gt;= 0 THEN &quot;Warm Lead (Recent Contact &gt;60% CR)&quot;&#10;ELSE &quot;Cold Lead (New Prospect)&quot;&#10;END' />
            </column>
            <column caption='Campaign' datatype='integer' name='[campaign]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3800291396112385]' derivation='None' name='[none:Calculation_3800291396112385:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3800291397017605]' derivation='None' name='[none:Calculation_3800291397017605:nk]' pivot='key' type='nominal' />
            <column caption='Pdays' datatype='integer' name='[pdays]' role='measure' type='quantitative' />
            <column caption='Poutcome' datatype='string' name='[poutcome]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3800291396452354]' derivation='User' name='[usr:Calculation_3800291396452354:qk]' pivot='key' type='quantitative' />
            <column caption='Y' datatype='string' name='[y]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
